{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/", "destination": "/legal_site/index.html" },
    { "source": "/privacy/", "destination": "/legal_site/privacy/index.html" },
    { "source": "/terms/", "destination": "/legal_site/terms/index.html" },
